## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache files
.vs/
.vscode/ # Usually better to exclude VSCode settings specific to user
# ReSharper is a common add-on to Visual Studio / Rider
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Rider is a common IDE
.idea/

# Backup and Special files
*.bak
*.tmp
*.log

# SQL Server files
*.mdf
*.ldf

# Test files
*.testsettings
TestResults/

# Dotnet coverage reports
*.coverage
*.coveragexml

# VS Installer assets by default are downloaded to %PROGRAMFILES(X86)%/Microsoft Visual Studio/Installer
# Adjust the path below according to your setup.
[Vv]s[Ii]nstaller/

# Other
*.exe
*.dll
*.pdb
*.nupkg
*.snupkg
*.zip
*.tar.gz
*.nuget.props
*.nuget.targets

# Explicit ignores (may be redundant due to general rules above)
.idea/
Sandbox/bin/
Sandbox/obj/
Makina.Engine/bin/
Makina.Engine/obj/ 